{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"],
    "jsx": "preserve",
    "jsxImportSource": "frameact",
    "paths": {
      "frameact": ["./src/index.ts"],
      "frameact/dom/controlled": ["./src/dom/controlledRegister.ts"],
      "frameact/dom": ["./src/dom/index.ts"],
      "frameact/kit": ["./src/kit/index.ts"],
      "frameact/store": ["./src/store/index.ts"],
      "frameact/stricterdom": ["./src/stricterdom/index.ts"],
      "frameact/jsx-runtime": ["./src/jsx-runtime.ts"]
    }
  },
  "include": ["src", "test"]
}
